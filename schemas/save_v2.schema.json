{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingfeng.local/schemas/save_v2.schema.json",
  "title": "Qingfeng Gameplay Save Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["save_format", "schema_version", "content_version", "save_id", "saved_at_utc", "snapshot", "checksum"],
  "properties": {
    "save_format": {"const": "qingfeng"},
    "schema_version": {"const": 2},
    "content_version": {"const": "first_playable_v1"},
    "save_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "saved_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "y": {"type": "number", "minimum": -1000000, "maximum": 1000000}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
    },
    "slot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["item_id", "quantity"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^item\\."},
        "quantity": {"type": "integer", "minimum": 1}
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_id", "space_id", "cell_position", "state", "crop_id", "growth_days", "is_watered", "last_settled_day"],
      "properties": {
        "plot_id": {"type": "string", "minLength": 1},
        "space_id": {"type": "string", "minLength": 1},
        "cell_position": {"$ref": "#/$defs/cell"},
        "state": {"enum": ["untilled", "tilled", "growing", "mature"]},
        "crop_id": {"type": ["string", "null"]},
        "growth_days": {"type": "integer", "minimum": 0},
        "is_watered": {"type": "boolean"},
        "last_settled_day": {"type": "integer", "minimum": 0}
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_version", "clock", "inventory", "wallet", "farm"],
      "properties": {
        "content_version": {"const": "first_playable_v1"},
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["game_minute"],
          "properties": {"game_minute": {"type": "integer", "minimum": 0}}
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "container_id", "capacity", "slots", "selected_slot_index"],
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "container_id": {"const": "container.player"},
            "capacity": {"const": 12},
            "slots": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/slot"}},
            "selected_slot_index": {"type": "integer", "minimum": 0, "maximum": 11}
          }
        },
        "wallet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "owner_id", "money"],
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "owner_id": {"const": "actor.player"},
            "money": {"type": "integer", "minimum": 0}
          }
        },
        "farm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "plots"],
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "plots": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/plot"}}
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "player_name", "dog_name", "space_id", "world_position_px", "facing", "gameplay"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "player_name": {"type": "string", "minLength": 1, "maxLength": 16},
        "dog_name": {"type": "string", "maxLength": 16},
        "space_id": {"type": "string", "minLength": 1},
        "world_position_px": {"$ref": "#/$defs/point"},
        "facing": {"enum": ["north", "south", "east", "west"]},
        "gameplay": {"$ref": "#/$defs/gameplay"}
      }
    }
  }
}
