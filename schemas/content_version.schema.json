{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingfeng.local/schemas/content_version.schema.json",
  "title": "Qingfeng first playable content version",
  "type": "object",
  "additionalProperties": false,
  "required": ["content_version", "clock", "inventory", "economy", "shop", "items", "crops", "new_game"],
  "properties": {
    "content_version": {"const": "first_playable_v1"},
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes_per_day", "day_start_minute"],
      "properties": {
        "minutes_per_day": {"type": "integer", "minimum": 1},
        "day_start_minute": {"type": "integer", "minimum": 0}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity"],
      "properties": {"capacity": {"type": "integer", "minimum": 1}}
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_money"],
      "properties": {"initial_money": {"type": "integer", "minimum": 0}}
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_minute", "close_minute"],
      "properties": {
        "open_minute": {"type": "integer", "minimum": 0},
        "close_minute": {"type": "integer", "minimum": 1}
      }
    },
    "items": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^item\\.": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stack_limit", "buy_price", "sell_price"],
          "properties": {
            "stack_limit": {"type": "integer", "minimum": 1},
            "buy_price": {"type": "integer", "minimum": 0},
            "sell_price": {"type": "integer", "minimum": 0}
          }
        }
      },
      "additionalProperties": false
    },
    "crops": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^crop\\.": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed_item_id", "harvest_item_id", "growth_days", "yield_quantity"],
          "properties": {
            "seed_item_id": {"type": "string", "pattern": "^item\\."},
            "harvest_item_id": {"type": "string", "pattern": "^item\\."},
            "growth_days": {"type": "integer", "minimum": 1},
            "yield_quantity": {"type": "integer", "minimum": 1}
          }
        }
      },
      "additionalProperties": false
    },
    "new_game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_items"],
      "properties": {
        "initial_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "quantity"],
            "properties": {
              "item_id": {"type": "string", "pattern": "^item\\."},
              "quantity": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
