{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingfeng.local/schemas/content_version.schema.json",
  "title": "Qingfeng first playable content version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_version",
    "clock",
    "inventory",
    "storage",
    "economy",
    "shop",
    "items",
    "crops",
    "forage",
    "residents",
    "new_game",
    "dialogues"
  ],
  "properties": {
    "content_version": {
      "const": "first_playable_v1"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minutes_per_day",
        "day_start_minute",
        "real_seconds_per_game_minute"
      ],
      "properties": {
        "minutes_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "day_start_minute": {
          "type": "integer",
          "minimum": 0
        },
        "real_seconds_per_game_minute": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_money"
      ],
      "properties": {
        "initial_money": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_minute",
        "close_minute"
      ],
      "properties": {
        "open_minute": {
          "type": "integer",
          "minimum": 0
        },
        "close_minute": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "items": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^item\\.": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stack_limit",
            "buy_price",
            "sell_price",
            "display_name"
          ],
          "properties": {
            "stack_limit": {
              "type": "integer",
              "minimum": 1
            },
            "buy_price": {
              "type": "integer",
              "minimum": 0
            },
            "sell_price": {
              "type": "integer",
              "minimum": 0
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            }
          }
        }
      },
      "additionalProperties": false
    },
    "crops": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^crop\\.": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed_item_id",
            "harvest_item_id",
            "growth_days",
            "yield_quantity"
          ],
          "properties": {
            "seed_item_id": {
              "type": "string",
              "pattern": "^item\\."
            },
            "harvest_item_id": {
              "type": "string",
              "pattern": "^item\\."
            },
            "growth_days": {
              "type": "integer",
              "minimum": 1
            },
            "yield_quantity": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "new_game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_items"
      ],
      "properties": {
        "initial_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "quantity"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "pattern": "^item\\."
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chest_capacity"
      ],
      "properties": {
        "chest_capacity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "forage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types"
      ],
      "properties": {
        "types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^forage\\.": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "quantity",
                "respawn_days"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^item\\."
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "respawn_days": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "residents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily_greeting_limit",
        "greeting_relationship_points",
        "daily_gift_limit",
        "definitions",
        "gift_relationship_points",
        "gift_item_ids"
      ],
      "properties": {
        "daily_greeting_limit": {
          "type": "integer",
          "minimum": 1
        },
        "daily_gift_limit": {
          "type": "integer",
          "minimum": 1
        },
        "definitions": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 3,
          "additionalProperties": false,
          "patternProperties": {
            "^resident\\.": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "display_name",
                "occupation_id",
                "home_anchor_id",
                "work_anchor_id",
                "social_anchor_id",
                "rain_anchor_id",
                "schedule",
                "rain_schedule"
              ],
              "properties": {
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "occupation_id": {
                  "type": "string",
                  "pattern": "^occupation\\."
                },
                "home_anchor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "work_anchor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "social_anchor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "rain_anchor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "schedule": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start_minute",
                      "activity_id",
                      "anchor_id"
                    ],
                    "properties": {
                      "start_minute": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1439
                      },
                      "activity_id": {
                        "enum": [
                          "home",
                          "work",
                          "social",
                          "rain"
                        ]
                      },
                      "anchor_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  }
                },
                "rain_schedule": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start_minute",
                      "activity_id",
                      "anchor_id"
                    ],
                    "properties": {
                      "start_minute": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1439
                      },
                      "activity_id": {
                        "enum": [
                          "home",
                          "work",
                          "social",
                          "rain"
                        ]
                      },
                      "anchor_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "greeting_relationship_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "gift_relationship_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "gift_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^item\\."
          }
        }
      }
    },
    "dialogues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_resident"
      ],
      "properties": {
        "player_resident": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^resident\\.": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "space_id",
                "first_meeting",
                "repeat"
              ],
              "properties": {
                "space_id": {
                  "type": "string",
                  "pattern": "^space\\.",
                  "maxLength": 128
                },
                "first_meeting": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dialogue_id",
                    "event_id",
                    "event_kind",
                    "text"
                  ],
                  "properties": {
                    "dialogue_id": {
                      "type": "string",
                      "pattern": "^dialogue\\.",
                      "maxLength": 128
                    },
                    "event_id": {
                      "type": "string",
                      "pattern": "^event\\.",
                      "maxLength": 128
                    },
                    "event_kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                },
                "repeat": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dialogue_id",
                    "text"
                  ],
                  "properties": {
                    "dialogue_id": {
                      "type": "string",
                      "pattern": "^dialogue\\.",
                      "maxLength": 128
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
